# ---- Application ----
DATABASE_URL=sqlite:///./complaints.db
LOG_LEVEL=INFO

# ---- AI provider: mock | anthropic ----
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
MODEL_NAME=claude-sonnet-5-5
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_RETRY_DELAY=1.0

# ---- Behaviour ----
LOW_CONFIDENCE_THRESHOLD=0.60
DUPLICATE_THRESHOLD=0.72
DUPLICATE_WINDOW_DAYS=14
REQUIRE_STUDENT_ID=false
REQUIRE_EMAIL=false

# ---- Admin access (leave ADMIN_PASSWORD empty ONLY for local development) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
