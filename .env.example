# =============================================================================
# University Complaint Management Portal — Environment Configuration Template
# Copy this file to '.env' and fill in your local MySQL credentials.
# =============================================================================

# ---- Database Configuration (MySQL 8.0 Primary) ----
# Connection format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/university_complaints
LOG_LEVEL=INFO

# ---- AI Provider (mock | anthropic) ----
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
MODEL_NAME=claude-sonnet-5-5
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_RETRY_DELAY=1.0

# ---- Complaint Engine Behavior & Thresholds ----
LOW_CONFIDENCE_THRESHOLD=0.60
DUPLICATE_THRESHOLD=0.72
DUPLICATE_WINDOW_DAYS=14
REQUIRE_STUDENT_ID=false
REQUIRE_EMAIL=false

# ---- Security & JWT Tokens ----
SECRET_KEY=replace-with-a-random-secure-secret-token-key-2026
ADMIN_REGISTRATION_TOKEN=ADMIN-SECRET-2026

# ---- Central Administrator Bootstrap Credentials ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- Transactional Email / SMTP Delivery (Optional) ----
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@university.edu.pk
SMTP_PASSWORD=your-email-app-password
SMTP_FROM_EMAIL=complaints@ue.edu.pk
SMTP_USE_TLS=true
